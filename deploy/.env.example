# Copy to .env and change every password before first start.
# Passwords can't be changed by editing this file after the database is created.

COMPANY_NAME=Breez Lending
# Printed on loan agreements, statements and receipts
COMPANY_ADDRESS=Port Moresby, National Capital District, Papua New Guinea
COMPANY_PHONE=
COMPANY_EMAIL=
TIMEZONE=Pacific/Port_Moresby

# Images. After the first successful start, pin exact versions/digests here
# (docker image ls --digests) so an update never happens by accident.
POSTGRES_TAG=16   # 15 or newer (init-db.sh uses \getenv)
FINERACT_IMAGE=apache/fineract:latest
WEBAPP_IMAGE=openmf/web-app:dev

# Ports on this machine
FINERACT_PORT=8080
# Which network address each port listens on. 127.0.0.1 = this computer only (the default for
# Fineract and the Mifos X admin app). Set 0.0.0.0 only if staff must reach them from other PCs.
FINERACT_BIND=127.0.0.1
MIFOS_BIND=127.0.0.1
MCLENDER_BIND=0.0.0.0
WEB_APP_PORT=8081   # Mifos X admin app; 80 is often taken on Windows

# URL staff browsers use to reach the API (use the server's LAN name/IP, not localhost, for other PCs)
PUBLIC_API_URL=http://localhost:8080

# Database superuser (only used by PostgreSQL itself)
POSTGRES_USER=root
POSTGRES_PASSWORD=change-me-superuser

# Application database user
FINERACT_DB_USER=fineract
FINERACT_DB_PASS=change-me-app

# ---------------------------------------------------------------- McLender
# fineract = real data; demo = sample data for training and demos
MCL_BACKEND=fineract
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
MCL_SESSION_SECRET=change-me-to-a-long-random-string
# Fineract user the borrower portal acts as (create it in Mifos X with limited permissions)
MCL_FINERACT_PORTAL_USER=portal
MCL_FINERACT_PORTAL_PASSWORD=change-me-portal
MCL_PORTAL_PRODUCT_ID=1
# Where staff and borrowers open McLender. Port 8088 locally; set a domain later for HTTPS.
MCLENDER_PORT=8088
MCLENDER_PUBLIC_URL=http://localhost:8088
# A domain name here (e.g. app.breezlending.com.pg) makes Caddy get an HTTPS certificate automatically;
# then also set MCL_COOKIE_SECURE=true and MCLENDER_PUBLIC_URL=https://<domain>
MCLENDER_SITE_ADDRESS=:80
MCL_COOKIE_SECURE=false
# No SMS provider yet (Digicel / Vodafone are chosen at shipping time), so borrower sign-in codes are
# not delivered. For testing on this PC ONLY, set true and read codes with:
#   docker compose logs mclender-api
# Never true on a server real borrowers use: codes would be in the logs.
MCL_SMS_LOG_CONTENT=false
# Loans can't be approved until the borrower's ID, payslips, bank statement and payroll deduction
# authority are uploaded. Set false only if you check documents some other way.
MCL_KYC_REQUIRED_FOR_APPROVAL=true
# The loan agreement is a draft until a PNG lawyer approves its wording. Set true only after that.
MCL_AGREEMENT_REVIEWED=false
