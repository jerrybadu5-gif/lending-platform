# McLender API settings (all prefixed MCL_). Copy to .env for local runs.

# demo = built-in sample data, no Fineract needed (staff login demo/demo or officer/officer)
# fineract = a real Fineract server (see deploy/)
MCL_BACKEND=demo
MCL_COMPANY_NAME=Breez Lending
MCL_TIMEZONE=Pacific/Port_Moresby

MCL_FINERACT_URL=http://localhost:8080
MCL_FINERACT_TENANT=default
MCL_FINERACT_VERIFY_TLS=true
# Technical Fineract user for the borrower portal: give it only read client, read loan, create loan
# and data table read/write permissions.
MCL_FINERACT_PORTAL_USER=
MCL_FINERACT_PORTAL_PASSWORD=
# Fineract loan product id that portal applications use
MCL_PORTAL_PRODUCT_ID=1

# Required with the Fineract back end: python -c "import secrets;print(secrets.token_urlsafe(48))"
MCL_SESSION_SECRET=dev-only-change-me
MCL_SESSION_HOURS=10
# true once the site is served over HTTPS
MCL_COOKIE_SECURE=false
MCL_ALLOWED_ORIGINS=["http://localhost:5173"]

# SMS: only "console" exists until the Digicel PNG / Vodafone PNG adapters are added at shipping time
MCL_SMS_PROVIDER=console
# Development only (demo back end): GET /api/dev/sms/{phone} shows the last SMS "sent"
MCL_DEV_SMS_INBOX=false

MCL_POLICY_FILE=policy.json
